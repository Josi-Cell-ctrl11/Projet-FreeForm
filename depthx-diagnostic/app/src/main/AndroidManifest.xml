<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Local sideload diagnostic: find OEM wallpaper providers whose names are not known yet. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <queries>
        <intent><action android:name="android.service.wallpaper.WallpaperService" /></intent>
        <intent><action android:name="android.intent.action.SET_WALLPAPER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
    </queries>
    <application android:label="DepthX Diagnostic" android:theme="@style/AppTheme"
        android:icon="@drawable/ic_depth" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
